      "required": [
        "safety_margin",
        "turnover_penalty",
        "min_rebalance_usd",
        "lookahead_closed_periods"
      ],
      "title": "PolicyConfig",
      "type": "object"
    },
    "PoolScanConfig": {
      "additionalProperties": false,
      "properties": {
        "depth_probe_usd": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Depth Probe Usd",
          "type": "array"
        },
        "quote_symbols": {
          "items": {
            "type": "string"
          },
          "title": "Quote Symbols",
          "type": "array"
        },
        "v3_fee_tiers": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "V3 Fee Tiers",
          "type": "array"
        }
      },
      "required": [
        "quote_symbols",
        "v3_fee_tiers",
