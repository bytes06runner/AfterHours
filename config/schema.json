{
  "$defs": {
    "AcceptanceConfig": {
      "additionalProperties": false,
      "properties": {
        "earnings_coverage_tolerance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Earnings Coverage Tolerance",
          "type": "number"
        },
        "overall_coverage_tolerance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Overall Coverage Tolerance",
          "type": "number"
        }
      },
      "required": [
        "overall_coverage_tolerance",
        "earnings_coverage_tolerance"
      ],
      "title": "AcceptanceConfig",
      "type": "object"
    },
    "AlertsConfig": {
      "additionalProperties": false,
      "properties": {
        "webhook_env": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Webhook Env",
          "type": "string"
        }
      },
      "required": [
        "webhook_env"
      ],
      "title": "AlertsConfig",
      "type": "object"
    },
    "ApiConfig": {
      "additionalProperties": false,
      "properties": {
        "admin_token_env": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Admin Token Env",
          "type": "string"
        },
        "cors_origins_env": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Cors Origins Env",
          "type": "string"
        },
        "host_env": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Host Env",
          "type": "string"
        },
        "port_env": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Port Env",
          "type": "string"
        }
      },
      "required": [
        "host_env",
        "port_env",
        "cors_origins_env",
        "admin_token_env"
      ],
      "title": "ApiConfig",
      "type": "object"
    },
    "BacktestConfig": {
      "additionalProperties": false,
      "properties": {
        "borrower_ltv_share_of_lltv": {
          "$ref": "#/$defs/BorrowerLtv"
        },
        "depth_source": {
          "enum": [
            "discovered",
            "none"
          ],
          "title": "Depth Source",
          "type": "string"
        },
        "loan_turnover_per_session": {
          "maximum": 1,
          "minimum": 0,
          "title": "Loan Turnover Per Session",
          "type": "number"
        },
        "lookaheads_to_tune": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Lookaheads To Tune",
          "type": "array"
        },
        "ltv_grid_points": {
          "exclusiveMinimum": 0,
          "title": "Ltv Grid Points",
          "type": "integer"
        },
        "max_worst_event_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Max Worst Event Share",
          "type": "number"
        },
        "rate_spread_multipliers": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Rate Spread Multipliers",
          "type": "array"
        },
        "replay": {
          "$ref": "#/$defs/ReplayConfig"
        },
        "safety_margins_to_tune": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Safety Margins To Tune",
          "type": "array"
        },
        "session_hours": {
          "exclusiveMinimum": 0,
          "title": "Session Hours",
          "type": "number"
        },
        "supply_apy_by_lltv": {
          "additionalProperties": {
            "exclusiveMaximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Supply Apy By Lltv",
          "type": "object"
        },
        "tier_pairs_to_tune": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Tier Pairs To Tune",
          "type": "array"
        },
        "turnover_sensitivity": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Turnover Sensitivity",
          "type": "array"
        },
        "utilization": {
          "maximum": 1,
          "minimum": 0,
          "title": "Utilization",
          "type": "number"
        },
        "vault_usdg": {
          "exclusiveMinimum": 0,
          "title": "Vault Usdg",
          "type": "number"
        }
      },
      "required": [
        "vault_usdg",
        "supply_apy_by_lltv",
        "utilization",
        "loan_turnover_per_session",
        "borrower_ltv_share_of_lltv",
        "ltv_grid_points",
        "session_hours",
        "depth_source",
        "tier_pairs_to_tune",
        "safety_margins_to_tune",
        "lookaheads_to_tune",
        "max_worst_event_share",
        "rate_spread_multipliers",
        "turnover_sensitivity",
        "replay"
      ],
      "title": "BacktestConfig",
      "type": "object"
    },
    "BaselinesConfig": {
      "additionalProperties": false,
      "properties": {
        "ewma_lambda": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Ewma Lambda",
          "type": "number"
        },
        "min_ticker_segment_rows": {
          "exclusiveMinimum": 0,
          "title": "Min Ticker Segment Rows",
          "type": "integer"
        }
      },
      "required": [
        "ewma_lambda",
        "min_ticker_segment_rows"
      ],
      "title": "BaselinesConfig",
      "type": "object"
    },
    "BorrowerLtv": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "maximum": 1,
          "minimum": 0,
          "title": "High",
          "type": "number"
        },
        "low": {
          "maximum": 1,
          "minimum": 0,
          "title": "Low",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "BorrowerLtv",
      "type": "object"
    },
    "ChainConfig": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chain Id"
        },
        "explorer_api_url": {
          "anyOf": [
            {
              "pattern": "^https?://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explorer Api Url"
        },
        "explorer_url": {
          "anyOf": [
            {
              "pattern": "^https?://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explorer Url"
        },
        "faucet_url": {
          "anyOf": [
            {
              "pattern": "^https?://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Faucet Url"
        },
        "public_rpc_url": {
          "anyOf": [
            {
              "pattern": "^https?://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Rpc Url"
        }
      },
      "title": "ChainConfig",
      "type": "object"
    },
    "ConformalConfig": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "cqr",
          "title": "Method",
          "type": "string"
        },
        "mondrian_segments": {
          "items": {
            "enum": [
              "earnings",
              "weekend",
              "holiday",
              "overnight"
            ],
            "type": "string"
          },
          "title": "Mondrian Segments",
          "type": "array"
        },
        "normalize": {
          "enum": [
            "none",
            "ewma"
          ],
          "title": "Normalize",
          "type": "string"
        }
      },
      "required": [
        "method",
        "mondrian_segments",
        "normalize"
      ],
      "title": "ConformalConfig",
      "type": "object"
    },
    "DataConfig": {
      "additionalProperties": false,
      "properties": {
        "alphavantage_key_env": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Alphavantage Key Env",
          "type": "string"
        },
        "cache_dir": {
          "title": "Cache Dir",
          "type": "string"
        },
        "cache_max_age_hours": {
          "exclusiveMinimum": 0,
          "title": "Cache Max Age Hours",
          "type": "number"
        },
        "download_batch_size": {
          "exclusiveMinimum": 0,
          "title": "Download Batch Size",
          "type": "integer"
        },
        "earnings_history_limit": {
          "exclusiveMinimum": 0,
          "title": "Earnings History Limit",
          "type": "integer"
        },
        "earnings_providers": {
          "items": {
            "enum": [
              "yfinance",
              "finnhub",
              "alphavantage"
            ],
            "type": "string"
          },
          "title": "Earnings Providers",
          "type": "array"
        },
        "exchange_calendar": {
          "title": "Exchange Calendar",
          "type": "string"
        },
        "finnhub_key_env": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Finnhub Key Env",
          "type": "string"
        },
        "market_ticker": {
          "title": "Market Ticker",
          "type": "string"
        },
        "providers": {
          "items": {
            "enum": [
              "yfinance",
              "stooq",
              "alphavantage"
            ],
            "type": "string"
          },
          "title": "Providers",
          "type": "array"
        },
        "request_pause_seconds": {
          "minimum": 0,
          "title": "Request Pause Seconds",
          "type": "number"
        },
        "sources": {
          "$ref": "#/$defs/DataSources"
        },
        "vix_ticker": {
          "title": "Vix Ticker",
          "type": "string"
        }
      },
      "required": [
        "providers",
        "earnings_providers",
        "exchange_calendar",
        "cache_dir",
        "vix_ticker",
        "market_ticker",
        "download_batch_size",
        "earnings_history_limit",
        "cache_max_age_hours",
        "request_pause_seconds",
        "finnhub_key_env",
        "alphavantage_key_env",
        "sources"
      ],
      "title": "DataConfig",
      "type": "object"
    },
    "DataSources": {
      "additionalProperties": false,
      "properties": {
        "alphavantage_url": {
          "pattern": "^https?://",
          "title": "Alphavantage Url",
          "type": "string"
        },
        "finnhub_url": {
          "pattern": "^https?://",
          "title": "Finnhub Url",
          "type": "string"
        },
        "sp500_constituents_url": {
          "pattern": "^https?://",
          "title": "Sp500 Constituents Url",
          "type": "string"
        },
        "stooq_daily_url": {
          "pattern": "^https?://",
          "title": "Stooq Daily Url",
          "type": "string"
        }
      },
      "required": [
        "sp500_constituents_url",
        "stooq_daily_url",
        "alphavantage_url",
        "finnhub_url"
      ],
      "title": "DataSources",
      "type": "object"
    },
    "DiscoveryConfig": {
      "additionalProperties": false,
      "properties": {
        "chain": {
          "title": "Chain",
          "type": "string"
        },
        "http_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Http Timeout Seconds",
          "type": "number"
        },
        "loan_token_symbol": {
          "title": "Loan Token Symbol",
          "type": "string"
        },
        "morpho_chain_key": {
          "title": "Morpho Chain Key",
          "type": "string"
        },
        "oracle_study": {
          "$ref": "#/$defs/OracleStudyConfig"
        },
        "pool_scan": {
          "$ref": "#/$defs/PoolScanConfig"
        },
        "sources": {
          "$ref": "#/$defs/DiscoverySources"
        },
        "uniswap_chain_id_key": {
          "title": "Uniswap Chain Id Key",
          "type": "string"
        },
        "user_agent": {
          "title": "User Agent",
          "type": "string"
        }
      },
      "required": [
        "chain",
        "loan_token_symbol",
        "morpho_chain_key",
        "uniswap_chain_id_key",
        "sources",
        "oracle_study",
        "pool_scan",
        "http_timeout_seconds",
        "user_agent"
      ],
      "title": "DiscoveryConfig",
      "type": "object"
    },
    "DiscoverySources": {
      "additionalProperties": false,
      "description": "Where each discovered fact comes from. Every entry is an official or primary source.",
      "properties": {
        "chainlink_feed_directory": {
          "pattern": "^https?://",
          "title": "Chainlink Feed Directory",
          "type": "string"
        },
        "chainlink_feed_docs": {
          "pattern": "^https?://",
          "title": "Chainlink Feed Docs",
          "type": "string"
        },
        "morpho_address_book": {
          "pattern": "^https?://",
          "title": "Morpho Address Book",
          "type": "string"
        },
        "morpho_addresses_docs": {
          "pattern": "^https?://",
          "title": "Morpho Addresses Docs",
          "type": "string"
        },
        "morpho_api": {
          "pattern": "^https?://",
          "title": "Morpho Api",
          "type": "string"
        },
        "robinhood_assets_api": {
          "pattern": "^https?://",
          "title": "Robinhood Assets Api",
          "type": "string"
        },
        "robinhood_token_contracts_page": {
          "pattern": "^https?://",
          "title": "Robinhood Token Contracts Page",
          "type": "string"
        },
        "uniswap_deployments": {
          "pattern": "^https?://",
          "title": "Uniswap Deployments",
          "type": "string"
        }
      },
      "required": [
        "robinhood_token_contracts_page",
        "robinhood_assets_api",
        "chainlink_feed_directory",
        "chainlink_feed_docs",
        "morpho_address_book",
        "morpho_addresses_docs",
        "morpho_api",
        "uniswap_deployments"
      ],
      "title": "DiscoverySources",
      "type": "object"
    },
    "GapsConfig": {
      "additionalProperties": false,
      "properties": {
        "drop_thresholds": {
          "items": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Drop Thresholds",
          "type": "array"
        },
        "quantiles": {
          "items": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Quantiles",
          "type": "array"
        },
        "worst_n": {
          "exclusiveMinimum": 0,
          "title": "Worst N",
          "type": "integer"
        }
      },
      "required": [
        "quantiles",
        "drop_thresholds",
        "worst_n"
      ],
      "title": "GapsConfig",
      "type": "object"
    },
    "LightGbmConfig": {
      "additionalProperties": false,
      "properties": {
        "learning_rate": {
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "min_child_samples": {
          "exclusiveMinimum": 0,
          "title": "Min Child Samples",
          "type": "integer"
        },
        "n_estimators": {
          "exclusiveMinimum": 0,
          "title": "N Estimators",
          "type": "integer"
        },
        "num_leaves": {
          "exclusiveMinimum": 0,
          "title": "Num Leaves",
          "type": "integer"
        }
      },
      "required": [
        "num_leaves",
        "learning_rate",
        "n_estimators",
        "min_child_samples"
      ],
      "title": "LightGbmConfig",
      "type": "object"
    },
    "LiquidationIncentiveConfig": {
      "additionalProperties": false,
      "properties": {
        "verify_from": {
          "title": "Verify From",
          "type": "string"
        }
      },
      "required": [
        "verify_from"
      ],
      "title": "LiquidationIncentiveConfig",
      "type": "object"
    },
    "LltvTiers": {
      "additionalProperties": false,
      "properties": {
        "weekday": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weekday"
        },
        "weekend": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weekend"
        }
      },
      "title": "LltvTiers",
      "type": "object"
    },
    "LocalNodeConfig": {
      "additionalProperties": false,
      "properties": {
        "port_env": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Port Env",
          "type": "string"
        },
        "url_template": {
          "pattern": "^https?://.*\\{port\\}",
          "title": "Url Template",
          "type": "string"
        }
      },
      "required": [
        "url_template",
        "port_env"
      ],
      "title": "LocalNodeConfig",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "$ref": "#/$defs/AcceptanceConfig"
        },
        "baselines": {
          "$ref": "#/$defs/BaselinesConfig"
        },
        "conformal": {
          "$ref": "#/$defs/ConformalConfig"
        },
        "lightgbm": {
          "$ref": "#/$defs/LightGbmConfig"
        },
        "n_jobs": {
          "title": "N Jobs",
          "type": "integer"
        },
        "quantiles": {
          "items": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Quantiles",
          "type": "array"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "target_alpha": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Target Alpha",
          "type": "number"
        },
        "target_scaling": {
          "enum": [
            "none",
            "ewma"
          ],
          "title": "Target Scaling",
          "type": "string"
        },
        "walk_forward": {
          "$ref": "#/$defs/WalkForwardConfig"
        }
      },
      "required": [
        "quantiles",
        "target_alpha",
        "conformal",
        "lightgbm",
        "walk_forward",
        "baselines",
        "acceptance",
        "seed",
        "n_jobs",
        "target_scaling"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "MorphoConfig": {
      "additionalProperties": false,
      "properties": {
        "liquidation_incentive": {
          "$ref": "#/$defs/LiquidationIncentiveConfig"
        },
        "lltv_tiers": {
          "$ref": "#/$defs/LltvTiers"
        },
        "vault_kind": {
          "anyOf": [
            {
              "enum": [
                "metamorpho",
                "vault-v2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vault Kind"
        }
      },
      "required": [
        "lltv_tiers",
        "liquidation_incentive"
      ],
      "title": "MorphoConfig",
      "type": "object"
    },
    "OnchainSelection": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "min_pool_depth_usd": {
          "minimum": 0,
          "title": "Min Pool Depth Usd",
          "type": "number"
        }
      },
      "required": [
        "max_tokens",
        "min_pool_depth_usd"
      ],
      "title": "OnchainSelection",
      "type": "object"
    },
    "OracleStudyConfig": {
      "additionalProperties": false,
      "properties": {
        "max_log_block_range": {
          "exclusiveMinimum": 0,
          "title": "Max Log Block Range",
          "type": "integer"
        },
        "weekends": {
          "exclusiveMinimum": 0,
          "title": "Weekends",
          "type": "integer"
        }
      },
      "required": [
        "weekends",
        "max_log_block_range"
      ],
      "title": "OracleStudyConfig",
      "type": "object"
    },
    "PathsConfig": {
      "additionalProperties": false,
      "properties": {
        "artifacts_dir": {
          "title": "Artifacts Dir",
          "type": "string"
        },
        "deployments_dir": {
          "title": "Deployments Dir",
          "type": "string"
        },
        "env_file": {
          "title": "Env File",
          "type": "string"
        }
      },
      "required": [
        "artifacts_dir",
        "deployments_dir",
        "env_file"
      ],
      "title": "PathsConfig",
      "type": "object"
    },
    "PolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "lookahead_closed_periods": {
          "exclusiveMinimum": 0,
          "title": "Lookahead Closed Periods",
          "type": "integer"
        },
        "min_rebalance_usd": {
          "minimum": 0,
          "title": "Min Rebalance Usd",
          "type": "number"
        },
        "safety_margin": {
          "maximum": 1,
          "minimum": 0,
          "title": "Safety Margin",
          "type": "number"
        },
        "turnover_penalty": {
          "minimum": 0,
          "title": "Turnover Penalty",
          "type": "number"
        }
