# Afterhours environment. Copy to .env and fill in. Never commit .env.
# Only throwaway keys and testnet or fork ETH. Never a key that holds real funds.

# RPC endpoints, one per network (full https URL from your RPC provider dashboard).
RH_MAINNET_RPC_URL=
RH_TESTNET_RPC_URL=
ARB_ONE_RPC_URL=
ARB_SEPOLIA_RPC_URL=

# Local Anvil port (the fork and local profiles run a node here; see config local_node).
# LOCAL_RPC_URL is unused: local profiles derive the node URL from ANVIL_PORT.
ANVIL_PORT=8545

# Throwaway private keys, each made with `cast wallet new`. Hex with 0x prefix.
DEPLOYER_PK=
CURATOR_PK=
ALLOCATOR_PK=
GUARDIAN_PK=

# API service. ADMIN_TOKEN guards the demo-only /v1/sim endpoints (`openssl rand -hex 32`).
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=
ADMIN_TOKEN=

# Web app. NEXT_PUBLIC_API_BASE_URL is the API origin the browser calls; `make web`
# derives it from API_HOST and API_PORT when left empty.
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional backup data providers (free tiers).
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# Optional explorer API key for contract verification.
ETHERSCAN_API_KEY=

# Optional alerts (a Discord channel webhook URL).
ALERT_WEBHOOK_URL=

# Optional overrides for config/afterhours.yaml, e.g. AFTERHOURS_ACTIVE_PROFILE=arb-sepolia.
# AFTERHOURS_CONFIG points the loaders at a different YAML file.
AFTERHOURS_ACTIVE_PROFILE=
